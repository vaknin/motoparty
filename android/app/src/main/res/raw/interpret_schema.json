{
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["play"] },
              "kind": { "type": "string", "enum": ["song", "album", "artist", "playlist", "similar"] },
              "query": { "type": "string" }
            },
            "required": ["type", "kind"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["add"] },
              "kind": { "type": "string", "enum": ["song", "album", "artist", "playlist", "similar"] },
              "query": { "type": "string" },
              "where": { "type": "string", "enum": ["next", "end", "instead"] },
              "count": { "type": "integer", "description": "Songs asked for; 0 when no number was said." }
            },
            "required": ["type", "kind", "where", "count"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["remove"] },
              "at": { "type": "array", "items": { "type": "integer" } },
              "artist": { "type": "string" }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["move"] },
              "at": { "type": "array", "items": { "type": "integer" } },
              "to": { "type": "integer", "description": "New position: 1 = next; past the end = the end." }
            },
            "required": ["type", "at", "to"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["jump"] },
              "at": { "type": "integer", "description": "An upNext number, or a played number (-1 to -5)." }
            },
            "required": ["type", "at"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["seek"] },
              "by": { "type": "integer", "description": "Seconds forward, negative = back." },
              "to": { "type": "integer", "description": "Seconds from the start." }
            },
            "required": ["type"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["repeat"] },
              "mode": { "type": "string", "enum": ["off", "track", "queue"] }
            },
            "required": ["type", "mode"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["tell"] },
              "about": { "type": "string", "enum": ["track", "album", "next", "remaining", "previous"] }
            },
            "required": ["type", "about"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["ask"] },
              "question": { "type": "string" },
              "kind": { "type": "string", "enum": ["song", "album", "artist", "playlist"] },
              "query": { "type": "string" }
            },
            "required": ["type", "question"]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["none", "pause", "resume", "next", "previous", "shuffle", "end", "restart", "undo", "volumeUp", "volumeDown", "clear"]
              }
            },
            "required": ["type"]
          }
        ]
      }
    }
  },
  "required": ["actions"]
}
