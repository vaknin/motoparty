   "name": "opener, first phrase parses",
   "role": "opener",
   "phrases": [
    {
     "text": "Play Dark Side of the Moon",
     "atMs": 3000
    },
    {
     "text": "next",
     "atMs": 6000
    }
   ],
   "expect": [
    "play dark side of the moon",
    null
   ]
  },
