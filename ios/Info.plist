<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Motoparty</string>

    <!-- Keep running with the screen locked: talk, music, keep-alive silence. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- The Live Activity (lock screen, Dynamic Island): what plays and the
         talk. Drawn by PlugIns/MotopartyWidgets.appex. -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <key>NSMicrophoneUsageDescription</key>
    <string>Motoparty uses the microphone for the helmet intercom and for spoken music commands.</string>

    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Motoparty recognises spoken music commands such as “play album …” on this iPhone.</string>

    <key>NSLocalNetworkUsageDescription</key>
    <string>Motoparty connects to the rider’s phone over its Wi-Fi hotspot for voice and music.</string>

    <key>NSBonjourServices</key>
    <array>
        <string>_motoparty._tcp</string>
    </array>

    <!-- Plain HTTP to the host on the LAN (GET /track/<id>.m4a). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- Stop iOS from powering Wi-Fi down after 30 minutes of inactivity. -->
    <key>UIRequiresPersistentWiFi</key>
    <true/>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
