<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared on purpose but NOT requested at runtime by the app: the spike must find out
         whether SpeechRecognizer refuses to serve a caller that does not hold RECORD_AUDIO.
         run.sh grants it only when GRANT=1, so both cases can be tried. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Package visibility (targetSdk >= 30): without these, the TTS engine and the
         on-device RecognitionService are invisible and both look "unavailable". -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="Motoparty Spike"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
